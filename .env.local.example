# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar integration (src/features/integrations/google-calendar)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# (Web application type). Add GOOGLE_OAUTH_REDIRECT_URI as an authorized
# redirect URI on that client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/oauth/callback
# Random 32-byte key, base64-encoded — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=
# Random secret used to sign the OAuth `state` parameter (any long random string).
GOOGLE_OAUTH_STATE_SECRET=
